flowchart TB
    work[/Code or content change/]
    dev[dev branch]
    pr[PR to master]
    ci{CI passes?}
    merge[Merge commit]
    master[master]
    build[Static build]
    upload[Upload assets, then pages]
    production[cPanel site]
    verify{Production checks pass?}
    stop[Stop workflow]
    releaseCheck{Release-worthy commits?}
    noRelease[Deployment only]
    semanticRelease[Semantic version + GitHub Release]
    telegram[/Telegram notification/]
    sync[Merge master back into dev]

    work --> dev
    dev --> pr
    pr --> ci
    ci -->|No| dev
    ci -->|Yes| merge
    merge --> master
    master --> build
    build --> upload
    upload --> production
    production --> verify
    verify -->|No| stop
    verify -->|Yes| releaseCheck
    releaseCheck -->|No| noRelease
    releaseCheck -->|Yes| semanticRelease
    noRelease --> telegram
    semanticRelease --> telegram
    master --> sync
    sync --> dev

    style ci fill:#332d20,stroke:#a28a4d
    style verify fill:#332d20,stroke:#a28a4d
    style releaseCheck fill:#332d20,stroke:#a28a4d
    style stop fill:#321f1f,stroke:#925c5c
    style master fill:#203026,stroke:#5f8f6d
    style production fill:#203026,stroke:#5f8f6d
    style semanticRelease fill:#203026,stroke:#5f8f6d
