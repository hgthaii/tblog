{
	"name": "tblog",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.25.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build --webpack",
		"build:path": "sh -c 'test -n \"$NEXT_PUBLIC_BASE_PATH\" || { echo \"NEXT_PUBLIC_BASE_PATH is required. Example: NEXT_PUBLIC_BASE_PATH=/ok pnpm build:path\"; exit 1; }; next build --webpack'",
		"start": "next start",
		"lint": "eslint"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"lucide-react": "^0.575.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.3.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"pnpm": {
		"overrides": {
			"js-yaml@<3.15.1": "3.15.1"
		}
	}
