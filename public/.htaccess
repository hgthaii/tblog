ErrorDocument 404 /404.html

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "/_next/static/" tblog_immutable_asset
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|txt|xml)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set Cache-Control "public, max-age=31536000, immutable" env=tblog_immutable_asset
</IfModule>
